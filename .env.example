OWS_TOKEN=
OWS_URL=https://ows.goszakup.gov.kz/v3/graphql
# Verified current portal/API timezone UTC+5; empty disables naive-time inference.
OWS_PUBLICATION_UTC_OFFSET_MINUTES=300
DATABASE_URL=sqlite:///./data/procurement.db
# Gemini is the default; a working Google API key is required.
LLM_PROVIDER=gemini
ALLOW_RULES_FALLBACK=false
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# LLM_PROVIDER=gemini
PAGE_SIZE=50
REQUEST_INTERVAL=0.3
MIN_PEERS=5
SYNC_INTERVAL_HOURS=6
