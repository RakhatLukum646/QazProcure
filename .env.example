OWS_TOKEN=
OWS_URL=https://ows.goszakup.gov.kz/v3/graphql
DATABASE_URL=sqlite:///./data/procurement.db
# Fill GOOGLE_API_KEY (Gemini) or both OLLAMA_URL/OLLAMA_MODEL to parse free-text
# RU/KZ questions with a real language model. Leave LLM_PROVIDER unset: it then
# auto-selects gemini > ollama > the restricted rule-based parser, in that order,
# based on which of the keys below are actually filled in. Set LLM_PROVIDER
# explicitly only to force one option regardless of what's configured.
OLLAMA_URL=
OLLAMA_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# LLM_PROVIDER=gemini
PAGE_SIZE=50
REQUEST_INTERVAL=0.3
MIN_PEERS=5
SYNC_INTERVAL_HOURS=6
